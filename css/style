:root{
  --bg:#07101c;
  --bg2:#0c1626;
  --panel:rgba(255,255,255,.04);
  --panel-2:rgba(255,255,255,.06);
  --line:rgba(107,179,255,.18);
  --line-2:rgba(107,179,255,.35);
  --text:#eef4ff;
  --muted:#9eb0c7;
  --blue:#6bb3ff;
  --shadow:0 18px 50px rgba(0,0,0,.35);
  --radius:22px;
  --wrap:1180px;
}

*,
*::before,
*::after{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family: Arial, Helvetica, sans-serif;
  color:var(--text);
  background:
    radial-gradient(circle at top, rgba(70,120,220,.18), transparent 34%),
    linear-gradient(180deg, #050b14 0%, #07101c 42%, #08111f 100%);
  line-height:1.7;
}

img{
  display:block;
  max-width:100%;
}

a{
  color:inherit;
  text-decoration:none;
}

.site-wrap,
.nav-inner{
  width:min(var(--wrap), calc(100% - 40px));
  margin:0 auto;
}

.site-header{
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(5,11,20,.82);
  backdrop-filter:blur(14px);
  border-bottom:1px solid var(--line);
}

.nav-inner{
  min-height:74px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
}

.logo{
  padding:10px 16px;
  border:1px solid rgba(107,179,255,.22);
  border-radius:12px;
  background:rgba(255,255,255,.02);
  color:var(--text);
  font-weight:700;
  letter-spacing:.04em;
  transition:.2s ease;
}

.logo:hover{
  border-color:var(--line-2);
  color:var(--blue);
}

.menu{
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.menu a{
  display:block;
  padding:10px 14px;
  border-radius:10px;
  color:var(--muted);
  transition:.2s ease;
}

.menu a:hover,
.menu a.active{
  color:var(--blue);
  background:rgba(107,179,255,.08);
}

.hero{
  min-height:100vh;
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);
  gap:48px;
  align-items:center;
  padding:60px 0 40px;
}

.hero-title{
  margin:0 0 12px;
  font-size:clamp(2.8rem, 7vw, 5.6rem);
  line-height:1;
  letter-spacing:-.04em;
}

.hero-role{
  margin:0 0 22px;
  font-size:clamp(1.2rem, 2.8vw, 2rem);
  color:var(--blue);
}

.hero-contacts p{
  margin:0 0 12px;
  font-size:1.08rem;
}

.hero-contacts strong{
  color:#ffffff;
  margin-right:8px;
}

.hero-btns{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-top:28px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:46px;
  padding:12px 22px;
  border-radius:14px;
  font-weight:700;
  transition:.22s ease;
}

.btn:hover{
  transform:translateY(-2px);
}

.btn-primary{
  background:linear-gradient(135deg, #6bb3ff, #94cfff);
  color:#04101d;
  box-shadow:0 10px 28px rgba(58,138,240,.28);
}

.btn-ghost{
  border:1px solid rgba(107,179,255,.28);
  background:rgba(255,255,255,.03);
  color:var(--text);
}

.btn-ghost:hover{
  color:var(--blue);
  border-color:rgba(107,179,255,.46);
}

.hero-photo{
  display:flex;
  justify-content:center;
}

.photo-card{
  width:min(100%, 430px);
  aspect-ratio:1/1.18;
  border-radius:30px;
  overflow:hidden;
  border:1px solid var(--line);
  background:linear-gradient(160deg, rgba(12,22,38,.95), rgba(6,12,21,.98));
  box-shadow:var(--shadow);
}

.photo-card img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.section{
  padding:30px 0 90px;
}

.section-head{
  display:flex;
  align-items:center;
  gap:18px;
  margin-bottom:26px;
}

.section-head h2{
  margin:0;
  font-size:clamp(1.8rem, 4vw, 2.7rem);
  line-height:1.1;
  letter-spacing:.02em;
}

.section-head::after{
  content:"";
  height:1px;
  flex:1;
  background:var(--line);
}

.section-box{
  border:1px solid var(--line);
  background:linear-gradient(160deg, rgba(11,21,37,.92), rgba(6,12,21,.98));
  border-radius:var(--radius);
  padding:28px;
  box-shadow:var(--shadow);
}

.section-box p{
  margin:0;
  font-size:1.08rem;
}

.big-list{
  margin:0;
  padding-left:24px;
}

.big-list li{
  margin-bottom:16px;
  font-size:1.08rem;
}

.big-list li:last-child{
  margin-bottom:0;
}

.timeline{
  display:grid;
  gap:18px;
}

.timeline-card{
  border:1px solid var(--line);
  background:linear-gradient(160deg, rgba(11,21,37,.92), rgba(6,12,21,.98));
  border-radius:var(--radius);
  padding:28px;
  box-shadow:var(--shadow);
}

.timeline-card .time{
  margin:0 0 12px;
  color:var(--blue);
  font-weight:700;
  font-size:1.02rem;
}

.timeline-card h3{
  margin:0 0 10px;
  font-size:1.35rem;
}

.timeline-card p{
  margin:0 0 8px;
  font-size:1.05rem;
}

.timeline-card .place{
  color:var(--muted);
  font-style:italic;
}

.contacts-grid{
  display:grid;
  grid-template-columns:repeat(3, minmax(0,1fr));
  gap:16px;
}

.contact-card{
  display:flex;
  flex-direction:column;
  gap:8px;
  min-height:130px;
  padding:22px;
  border-radius:20px;
  border:1px solid var(--line);
  background:linear-gradient(160deg, rgba(11,21,37,.92), rgba(6,12,21,.98));
  box-shadow:var(--shadow);
  transition:.22s ease;
}

.contact-card:hover{
  transform:translateY(-4px);
  border-color:var(--line-2);
}

.contact-label{
  color:var(--blue);
  font-size:.95rem;
  font-weight:700;
  letter-spacing:.04em;
}

.contact-value{
  color:var(--text);
  font-size:1.08rem;
  word-break:break-word;
}

.fade{
  opacity:0;
  transform:translateY(22px);
  transition:opacity .65s ease, transform .65s ease;
}

.fade.on{
  opacity:1;
  transform:none;
}

@media (max-width:980px){
  .hero{
    grid-template-columns:1fr;
    padding-top:40px;
  }

  .hero-photo{
    order:-1;
  }

  .contacts-grid{
    grid-template-columns:1fr;
  }
}

@media (max-width:700px){
  .nav-inner{
    min-height:auto;
    padding:14px 0;
    flex-direction:column;
    align-items:flex-start;
  }

  .site-wrap,
  .nav-inner{
    width:min(var(--wrap), calc(100% - 26px));
  }

  .menu{
    gap:4px;
  }

  .menu a{
    padding:8px 10px;
    font-size:.95rem;
  }

  .hero{
    gap:28px;
    min-height:auto;
    padding:28px 0 30px;
  }

  .section{
    padding:20px 0 70px;
  }

  .section-box,
  .timeline-card,
  .contact-card{
    padding:20px;
  }

  .btn{
    width:100%;
  }
}